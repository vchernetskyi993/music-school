{
  "name": "music-school",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && npm run stylelint",
    "stylelint": "stylelint '**/*.css' --cache --allow-empty-input",
    "format:check": "oxfmt --check",
    "format": "oxfmt",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "npm run build && overweight",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run size",
    "analyze": "npx vite-bundle-analyzer"
  },
  "dependencies": {
    "@mantine/core": "^9.3.0",
    "@mantine/hooks": "^9.3.0",
    "@tabler/icons-react": "^3.34.1",
    "howler": "^2.2.4",
    "pitchy": "^4.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "react-screen-wake-lock": "^3.1.1",
    "rxjs": "^7.8.2",
    "standardized-audio-context": "^25.3.77",
    "tonal": "^6.4.2",
    "vexflow": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.6.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.1.1",
    "gh-pages": "^6.3.0",
    "identity-obj-proxy": "^3.0.0",
    "jsdom": "^30.1.0",
    "overweight": "^2.2.0",
    "oxc-config-mantine": "^1.0.3",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "postcss": "^8.5.5",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "prop-types": "^15.8.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-bundle-analyzer": "^1.3.9",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
